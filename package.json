{
  "name": "vstack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "trap 'kill 0' INT TERM EXIT; node --watch server/index.ts & vite",
    "server": "node --watch server/index.ts",
    "voices": "node scripts/audition.ts",
    "tts-setup": "node scripts/tts-setup.ts",
    "youtube-auth": "node scripts/youtube-auth.ts",
    "facebook-auth": "node scripts/facebook-auth.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('media',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
